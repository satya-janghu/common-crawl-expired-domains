# Expired Domain Finder reads these from the shell environment (export them, or use direnv).
# The app does not auto-load this file. Never commit real values.

# Porkbun registrar credentials (optional; without them results stop at DNS/RDAP confidence)
PORKBUN_API_KEY=your-porkbun-api-key
PORKBUN_SECRET_KEY=your-porkbun-secret-key

# Data directory used in the docs' example commands (passed as --data-dir "$EDF_DATA_DIR")
EDF_DATA_DIR=./edf-data

# Optional: default data dir base when --data-dir is not given (falls back to ~/.local/share/expired-domain-finder)
# XDG_DATA_HOME=/path/to/data-home
